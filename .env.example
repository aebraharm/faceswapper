# Paths to a compatible, legally acquired ONNX model bundle (see models/README.md).
FACE_SOURCE_ENCODER_MODEL=models/source_encoder.onnx
FACE_TRANSFORMER_MODEL=models/face_transformer.onnx
# Optional MediaPipe Tasks face-landmarker asset for newer MediaPipe releases.
FACE_LANDMARKER_TASK=models/face_landmarker.task
FACE_ONNX_PROVIDER=auto

# Optional upload/pipeline limits.
FACE_MAX_UPLOAD_BYTES=8388608
FACE_PROCESSING_RESOLUTION=640
